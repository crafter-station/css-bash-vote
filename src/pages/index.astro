---
import { SignInButton } from "@clerk/astro/components";
import { count, countDistinct, eq, max } from "drizzle-orm";

import { CrafterStationLogo } from "../components/CrafterStationLogo";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { db } from "../db";
import { challenges, rounds, votes } from "../db/schema";

const { userId } = Astro.locals.auth();
const isSignedIn = !!userId;

// If signed in, compute the round we should resume on and total progress.
let resumeSlug: string | null = null;
let resumeRoundName: string | null = null;
let totalVoted = 0;

if (isSignedIn && userId) {
  try {
    const rows = await db
      .select({
        roundId: challenges.roundId,
        challengeId: votes.challengeId,
      })
      .from(votes)
      .innerJoin(challenges, eq(votes.challengeId, challenges.id))
      .where(eq(votes.userId, userId));

    totalVoted = rows.length;

    const countByRoundId: Record<number, number> = {};
    for (const r of rows) {
      countByRoundId[r.roundId] = (countByRoundId[r.roundId] ?? 0) + 1;
    }

    const allRounds = await db
      .select({
        id: rounds.id,
        slug: rounds.slug,
        name: rounds.name,
        position: rounds.position,
      })
      .from(rounds)
      .orderBy(rounds.position);

    // Pick the first round with progress > 0 and < 10 (in progress).
    // Fallback to the first round with 0 progress (untouched).
    const inProgress = allRounds.find(
      (r) => (countByRoundId[r.id] ?? 0) > 0 && (countByRoundId[r.id] ?? 0) < 10,
    );
    const untouched = allRounds.find((r) => (countByRoundId[r.id] ?? 0) === 0);
    const target = inProgress ?? untouched;
    if (target) {
      resumeSlug = target.slug;
      resumeRoundName = target.name;
    }
  } catch {
    // Silent — fallback to default Start voting.
  }
}

const hasProgress = totalVoted > 0 && totalVoted < 60;
const isFullyDone = totalVoted >= 60;

let totalCommunityVotes = 0;
let totalVoters = 0;
let latestVoteAt: Date | null = null;

try {
  const [statsRow] = await db
    .select({
      totalVotes: count(),
      uniqueVoters: countDistinct(votes.userId),
      lastVote: max(votes.createdAt),
    })
    .from(votes);
  if (statsRow) {
    totalCommunityVotes = statsRow.totalVotes;
    totalVoters = statsRow.uniqueVoters;
    latestVoteAt = statsRow.lastVote ? new Date(statsRow.lastVote) : null;
  }
} catch {
  // silent — defaults stay 0/0/null
}

function relativeTime(date: Date | null): string {
  if (!date) return "";
  const diffMs = Date.now() - date.getTime();
  const diffSec = Math.floor(diffMs / 1000);
  if (diffSec < 60) return "just now";
  const diffMin = Math.floor(diffSec / 60);
  if (diffMin < 60) return `${diffMin} min ago`;
  const diffHr = Math.floor(diffMin / 60);
  if (diffHr < 24) return `${diffHr}h ago`;
  const diffDays = Math.floor(diffHr / 24);
  return `${diffDays}d ago`;
}

const isLive = latestVoteAt !== null && Date.now() - latestVoteAt.getTime() < 5 * 60 * 1000;
const showSocialProof = totalCommunityVotes > 0;
---

<Layout title="css-bash">
  <div class="landing-bg flex h-screen flex-col overflow-hidden relative">
    <Header isSignedIn={isSignedIn} />

    <main class="relative z-[1] mx-auto flex w-full max-w-[1280px] flex-1 items-center justify-center overflow-hidden px-4 sm:px-6">
      <section class="flex w-full flex-col items-center justify-center gap-4 text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[var(--line)] bg-[var(--bg-secondary)] px-3.5 py-1 text-xs font-medium text-[var(--fg-dim)]">
          <CrafterStationLogo className="h-3 w-3" variant="icon" colorScheme="gold" mode="light" />
          Crafter Station . Community Benchmark
        </div>

        <div class="max-w-[760px]">
          <h1 class="m-0 mb-3 whitespace-nowrap text-[clamp(1.5rem,5.2vw,3.5rem)] font-extrabold leading-[1.1] tracking-[-0.04em]">
            Which AI writes
            <span class="text-[var(--amber)]">better CSS</span>?
          </h1>
          <p class="m-0 text-sm sm:text-base text-[var(--fg-dim)] leading-[1.6]">
            60 modern CSS challenges across 6 themed rounds. Two anonymous Codex agents per challenge:
            one with
            <a
              href="https://github.com/crafter-station/css-bash"
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-[var(--fg)] no-underline hover:text-[var(--amber)] transition-colors"
            >css-bash</a>
            and one vanilla. You decide which output is stronger.
          </p>
        </div>

        {isSignedIn && hasProgress && resumeSlug && (
          <div class="w-full max-w-[420px]">
            <div class="mb-2 flex items-center justify-between text-xs text-[var(--fg-dim)]">
              <span>Your progress</span>
              <span><strong class="text-[var(--fg)]">{totalVoted}</strong> / 60 votes</span>
            </div>
            <div class="h-1.5 overflow-hidden rounded-full bg-[var(--bg-secondary)] border border-[var(--line)]">
              <div class="h-full bg-gradient-to-r from-[var(--amber)] to-[var(--sky)] transition-[width] duration-300" style={`width: ${(totalVoted / 60) * 100}%`}></div>
            </div>
          </div>
        )}

        <div class="flex flex-wrap justify-center gap-3">
          {isSignedIn ? (
            isFullyDone ? (
              <>
                <a
                  href="/results/me"
                  class="inline-flex items-center gap-2 rounded-lg bg-[var(--fg)] px-6 py-2.5 text-sm font-bold text-[var(--bg)] tracking-[-0.01em] no-underline hover:opacity-90 transition-opacity"
                >
                  See your results
                </a>
                <a
                  href="/results"
                  class="inline-flex items-center rounded-lg border border-[var(--line)] bg-transparent px-6 py-2.5 text-sm font-semibold text-[var(--fg)] no-underline hover:border-[var(--fg)] transition-colors"
                >
                  See community results
                </a>
                <a
                  href="/vote"
                  class="inline-flex items-center text-sm font-medium text-[var(--fg-dim)] no-underline hover:text-[var(--fg)] transition-colors px-2 py-2.5"
                >
                  Revisit votes
                </a>
              </>
            ) : hasProgress && resumeSlug ? (
              <>
                <a
                  href={`/vote?round=${resumeSlug}`}
                  class="inline-flex items-center gap-2 rounded-lg bg-[var(--fg)] px-6 py-2.5 text-sm font-bold text-[var(--bg)] tracking-[-0.01em] no-underline hover:opacity-90 transition-opacity"
                >
                  Continue: {resumeRoundName}
                </a>
                <a
                  href="/results/me"
                  class="inline-flex items-center rounded-lg border border-[var(--line)] bg-transparent px-6 py-2.5 text-sm font-semibold text-[var(--fg)] no-underline hover:border-[var(--fg)] transition-colors"
                >
                  See your results
                </a>
                <a
                  href="/vote"
                  class="inline-flex items-center text-sm font-medium text-[var(--fg-dim)] no-underline hover:text-[var(--fg)] transition-colors px-2 py-2.5"
                >
                  All challenges
                </a>
                <a
                  href="/results"
                  class="inline-flex items-center text-sm font-medium text-[var(--fg-dim)] no-underline hover:text-[var(--fg)] transition-colors px-2 py-2.5"
                >
                  See community results
                </a>
              </>
            ) : (
              <>
                <a
                  href="/vote"
                  class="inline-flex items-center gap-2 rounded-lg bg-[var(--fg)] px-6 py-2.5 text-sm font-bold text-[var(--bg)] tracking-[-0.01em] no-underline hover:opacity-90 transition-opacity"
                >
                  Start voting
                </a>
                <a
                  href="/results"
                  class="inline-flex items-center rounded-lg border border-[var(--line)] bg-transparent px-6 py-2.5 text-sm font-semibold text-[var(--fg)] no-underline hover:border-[var(--fg)] transition-colors"
                >
                  See community results
                </a>
              </>
            )
          ) : (
            <>
              <SignInButton mode="modal" forceRedirectUrl="/vote" signUpForceRedirectUrl="/vote" asChild>
                <button
                  type="button"
                  class="inline-flex items-center gap-2 rounded-lg bg-[var(--fg)] px-6 py-2.5 text-sm font-bold text-[var(--bg)] tracking-[-0.01em] hover:opacity-90 transition-opacity"
                >
                  Sign in to vote
                </button>
              </SignInButton>
              <a
                href="/results"
                class="inline-flex items-center rounded-lg border border-[var(--line)] bg-transparent px-6 py-2.5 text-sm font-semibold text-[var(--fg)] no-underline hover:border-[var(--fg)] transition-colors"
              >
                See community results
              </a>
            </>
          )}
        </div>

        {showSocialProof && (
          <div class="mx-auto mt-1 flex max-w-[520px] items-center justify-center gap-1.5 text-xs text-[var(--fg-dim)]">
            {isLive && (
              <span class="relative flex h-2 w-2 shrink-0">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" style="background:#10b981"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full" style="background:#10b981"></span>
              </span>
            )}
            <span>
              <strong class="text-[var(--fg)]">{totalCommunityVotes}</strong> community votes
            </span>
            <span class="text-[var(--line)]">·</span>
            <span>
              <strong class="text-[var(--fg)]">{totalVoters}</strong> voters
            </span>
            {latestVoteAt && (
              <>
                <span class="text-[var(--line)]">·</span>
                <span>last vote {relativeTime(latestVoteAt)}</span>
              </>
            )}
          </div>
        )}

        <div class="flex w-full max-w-[640px] flex-wrap items-baseline justify-center gap-x-6 gap-y-2 text-[var(--fg-dim)] text-sm">
          <span class="inline-flex items-baseline gap-1.5">
            <span class="text-xl font-extrabold tracking-[-0.04em] text-[var(--fg)]">6</span>
            rounds
          </span>
          <span class="text-[var(--line)]">.</span>
          <span class="inline-flex items-baseline gap-1.5">
            <span class="text-xl font-extrabold tracking-[-0.04em] text-[var(--amber)]">60</span>
            challenges
          </span>
          <span class="text-[var(--line)]">.</span>
          <span class="inline-flex items-baseline gap-1.5">
            <span class="text-xl font-extrabold tracking-[-0.04em] text-[var(--sky)]">120</span>
            outputs
          </span>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--line)] bg-[var(--bg-secondary)] px-3 py-1 text-[var(--fg-dim)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--amber)]"></span>
            css-bash
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--line)] bg-[var(--bg-secondary)] px-3 py-1 text-[var(--fg-dim)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--sky)]"></span>
            vanilla
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-full border border-[var(--line)] bg-[var(--bg-secondary)] px-3 py-1 text-[var(--fg-dim)]">
            Blind voting
          </span>
        </div>
      </section>
    </main>

    <footer class="relative z-[1] border-t border-[var(--line)] bg-[var(--bg)]/60 backdrop-blur">
      <div class="mx-auto flex max-w-[1280px] flex-col items-center gap-3 px-4 py-3 sm:flex-row sm:justify-between sm:px-6">
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-[var(--fg-dim)]">
          <span class="text-[0.7rem] uppercase tracking-[0.08em] text-[var(--fg-dim)]">More from Crafter Station</span>
          <a
            href="https://tinte.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--fg-dim)] no-underline hover:text-[var(--fg)] transition-colors"
          >tinte</a>
          <a
            href="https://tryelements.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--fg-dim)] no-underline hover:text-[var(--fg)] transition-colors"
          >elements</a>
          <a
            href="https://hack0.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--fg-dim)] no-underline hover:text-[var(--fg)] transition-colors"
          >hack0</a>
          <a
            href="https://github.com/crafter-station"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--fg-dim)] no-underline hover:text-[var(--fg)] transition-colors"
          >github</a>
        </div>
        <div class="text-xs text-[var(--fg-dim)]">
          Built by
          <a
            href="https://railly.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-[var(--fg)] no-underline hover:text-[var(--amber)] transition-colors"
          >Railly Hugo</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
