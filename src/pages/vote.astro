---
import Layout from "../layouts/Layout.astro";

const { userId } = Astro.locals.auth();

if (!userId) {
  return Astro.redirect("/sign-in");
}
---

<Layout title="Vote">
  <style is:global>
    /* biome-ignore lint/complexity/noImportantStyles: shiki dual-theme needs !important to override inline style attrs from codeToHtml output */
    [data-theme="dark"] .shiki,
    [data-theme="dark"] .shiki span {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
      text-decoration: var(--shiki-dark-text-decoration) !important;
    }
    /* biome-ignore lint/complexity/noImportantStyles: shiki dual-theme needs !important to override inline style attrs from codeToHtml output */
    .shiki {
      background: transparent !important;
      padding: 14px 18px;
      margin: 0;
      font-size: 12px;
      line-height: 1.55;
    }
  </style>
  <style is:global>
    #vote-app {
      height: 100vh;
      overflow: hidden;
      background: var(--bg);
      display: flex;
      flex-direction: column;
    }

    .vote-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1rem;
      height: 48px;
      border-bottom: 1px solid var(--line);
      background: var(--bg);
      flex-shrink: 0;
      gap: 0.5rem;
    }

    .vote-header-center {
      display: flex;
      align-items: center;
      gap: 1rem;
      min-width: 0;
      flex: 1;
      justify-content: flex-end;
    }

    .challenge-title {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--fg);
      max-width: 400px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .prompt-trigger {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      background: none;
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--fg-dim);
      cursor: pointer;
      font-size: 0.75rem;
      font-family: inherit;
      transition: color 0.15s, border-color 0.15s;
    }

    .prompt-trigger:hover,
    .prompt-trigger.active {
      color: var(--fg);
      border-color: var(--fg);
    }

    .prompt-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(2px);
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .prompt-modal {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 12px;
      max-width: 720px;
      width: 100%;
      max-height: 80vh;
      overflow-y: auto;
      padding: 1.5rem;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .prompt-modal h3 {
      margin: 0 0 0.5rem;
      font-size: 1rem;
      font-weight: 700;
    }

    .prompt-modal-meta {
      font-size: 0.75rem;
      color: var(--fg-dim);
      margin-bottom: 1rem;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .prompt-modal pre {
      margin: 0;
      padding: 1rem;
      background: var(--bg-secondary);
      border: 1px solid var(--line);
      border-radius: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.8rem;
      line-height: 1.6;
      color: var(--fg);
      white-space: pre-wrap;
      word-break: break-word;
    }

    .prompt-modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: 1px solid var(--line);
      color: var(--fg-dim);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .prompt-modal-close:hover {
      color: var(--fg);
      border-color: var(--fg);
    }

    .prompt-modal-wrapper {
      position: relative;
    }

    .round-selector {
      flex-shrink: 0;
      border-bottom: 1px solid var(--line);
      background: var(--bg-secondary);
      padding: 0 1rem;
      overflow-x: auto;
      scrollbar-width: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      height: 40px;
      scroll-snap-type: x mandatory;
    }

    .round-selector::-webkit-scrollbar {
      display: none;
    }

    .round-pill {
      flex-shrink: 0;
      padding: 4px 14px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: none;
      color: var(--fg-dim);
      font-size: 0.78rem;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      scroll-snap-align: start;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: inherit;
    }

    .round-pill:hover {
      border-color: var(--fg-dim);
      color: var(--fg);
    }

    .round-pill.active {
      background: var(--fg);
      color: var(--bg);
      border-color: var(--fg);
      font-weight: 700;
    }

    .round-pill.complete {
      border-color: #22c55e;
      color: #22c55e;
    }

    .round-pill.complete.active {
      background: #22c55e;
      color: #0b0d10;
      border-color: #22c55e;
    }

    .round-pill .progress-count {
      font-size: 0.7rem;
      opacity: 0.7;
      font-weight: 600;
    }

    .round-pill.complete .progress-count,
    .round-pill.active .progress-count {
      opacity: 0.85;
    }

    .panes-grid {
      position: relative;
      flex: 1;
      min-height: 0;
      overflow: hidden;
      --split: 50%;
      user-select: none;
      touch-action: none;
    }

    /* RIGHT pane is the base layer, full-width behind */
    .pane {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    /* LEFT pane is on top, clipped to the split fraction */
    .pane-left {
      clip-path: inset(0 calc(100% - var(--split)) 0 0);
      z-index: 1;
    }

    .pane-right {
      z-index: 0;
    }

    .pane iframe,
    .pane .pane-code {
      width: 100%;
      height: 100%;
    }

    /* Drag handle — sits on the dividing line */
    .pane-handle {
      position: absolute;
      top: 0;
      bottom: 0;
      left: var(--split);
      width: 14px;
      transform: translateX(-50%);
      cursor: ew-resize;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      touch-action: none;
    }

    .pane-handle::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      background: var(--line);
      transform: translateX(-50%);
      pointer-events: none;
    }

    .pane-handle-grip {
      position: relative;
      width: 36px;
      height: 64px;
      border-radius: 999px;
      background: var(--bg);
      border: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
      transition: transform 0.15s, border-color 0.15s;
    }

    .pane-handle:hover .pane-handle-grip,
    .pane-handle.dragging .pane-handle-grip {
      border-color: var(--fg);
      transform: scale(1.05);
    }

    .pane-handle-grip svg {
      color: var(--fg-dim);
    }

    /* Floating control clusters — sit on top of both panes, always clickable */
    .pane-controls {
      position: absolute;
      top: 8px;
      z-index: 30;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(6px);
      border-radius: 8px;
    }

    .pane-controls.left {
      left: 8px;
    }

    .pane-controls.right {
      right: 8px;
    }

    .pane-controls .label {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 8px;
      color: #fff;
      letter-spacing: 0.05em;
    }

    .pane-controls .toggle {
      background: none;
      border: none;
      color: #fff;
      border-radius: 6px;
      width: 28px;
      height: 28px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s;
    }

    .pane-controls .toggle:hover,
    .pane-controls .toggle.active {
      background: rgba(255, 255, 255, 0.18);
    }

    .pane-iframe {
      width: 100%;
      height: 100%;
      border: none;
      background: #fff;
    }

    .pane-code {
      height: 100%;
      overflow: auto;
      background: var(--bg-secondary);
      padding: 1rem;
    }

    .pane-code pre {
      margin: 0;
      overflow-x: auto;
    }

    /* Right pane is the base layer (full width). When showing code, encapsulate
       to the visible right side so the code starts where the split exposes it. */
    .pane-right .pane-code {
      padding-left: calc(var(--split) + 1rem);
    }
    .pane-right .pane-code pre {
      padding-right: 1rem;
    }

    .vote-footer {
      flex-shrink: 0;
      border-top: 1px solid var(--line);
      background: var(--bg);
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .vote-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .vote-btn {
      padding: 8px 18px;
      background: none;
      border-radius: 8px;
      font-weight: 700;
      cursor: pointer;
      font-size: 0.875rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      white-space: nowrap;
    }

    .vote-btn svg {
      flex-shrink: 0;
    }

    .nav-btn {
      padding: 6px 14px;
      background: none;
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--fg);
      cursor: pointer;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }

    .nav-btn svg {
      flex-shrink: 0;
    }

    .nav-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .reveal-panel {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--bg-secondary);
      border-top: 1px solid var(--line);
      z-index: 100;
      max-height: 60vh;
      overflow-y: auto;
    }

    .reveal-inner {
      max-width: 900px;
      margin: 0 auto;
      padding: 1.5rem;
      padding-top: 0;
    }

    .reveal-header {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 1rem 0 0.75rem;
      margin-bottom: 1rem;
      background: var(--bg-secondary);
      border-bottom: 1px solid var(--line);
      z-index: 2;
    }

    /* Floating "back to compare" pill — fixed top-right when reveal is open */
    .reveal-back-fab {
      position: fixed;
      top: 70px;
      right: 16px;
      z-index: 101;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 999px;
      background: var(--fg);
      color: var(--bg);
      border: none;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
      font-family: inherit;
    }
    .reveal-back-fab:hover {
      opacity: 0.9;
    }

    .shortcuts-hint {
      position: absolute;
      bottom: 10px;
      right: 12px;
      font-size: 0.7rem;
      color: var(--fg-dim);
      pointer-events: none;
      z-index: 10;
      animation: hint-fade 5s ease forwards;
    }

    .shortcuts-hint:hover {
      animation: none;
      opacity: 1;
    }

    @keyframes hint-fade {
      0% { opacity: 0.7; }
      60% { opacity: 0.7; }
      100% { opacity: 0; }
    }

    @media (max-width: 767px) {
      .shortcuts-hint {
        display: none;
      }
    }

    .shortcuts-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }

    .shortcuts-table td {
      padding: 5px 8px;
      vertical-align: middle;
    }

    .shortcuts-table td:first-child {
      width: 40%;
      color: var(--fg-dim);
    }

    .shortcuts-table tr:not(:last-child) td {
      border-bottom: 1px solid var(--line);
    }

    .shortcut-key {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 1px 6px;
      border: 1px solid var(--line);
      border-radius: 4px;
      background: var(--bg-secondary);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.75rem;
      color: var(--fg);
      margin-right: 3px;
    }

    .vote-toast {
      position: fixed;
      top: 70px;
      left: 50%;
      transform: translateX(-50%);
      padding: 10px 20px;
      border-radius: 999px;
      background: #10b981;
      color: white;
      font-weight: 700;
      font-size: 0.875rem;
      box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
      z-index: 300;
      pointer-events: none;
      animation: toast-show 2.2s ease forwards;
    }

    @keyframes toast-show {
      0% { opacity: 0; transform: translateX(-50%) translateY(-8px); }
      12% { opacity: 1; transform: translateX(-50%) translateY(0); }
      75% { opacity: 1; }
      100% { opacity: 0; transform: translateX(-50%) translateY(-4px); }
    }

    .error-toast {
      position: fixed;
      top: 70px;
      left: 50%;
      transform: translateX(-50%);
      padding: 10px 20px;
      border-radius: 999px;
      background: #ef4444;
      color: white;
      font-weight: 700;
      font-size: 0.875rem;
      box-shadow: 0 4px 20px rgba(239, 68, 68, 0.4);
      z-index: 300;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .error-toast-spinner {
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255,255,255,0.4);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      flex-shrink: 0;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .error-toast-retry-btn {
      background: rgba(255,255,255,0.2);
      border: 1px solid rgba(255,255,255,0.4);
      color: white;
      font-weight: 700;
      font-size: 0.8rem;
      border-radius: 999px;
      padding: 2px 10px;
      cursor: pointer;
      font-family: inherit;
    }

    .error-toast-retry-btn:hover {
      background: rgba(255,255,255,0.35);
    }

    .pane-skeleton {
      display: none;
      position: absolute;
      inset: 0;
      z-index: 5;
      background: var(--bg-secondary);
      overflow: hidden;
    }

    .pane-skeleton::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent 0%, var(--line) 50%, transparent 100%);
      animation: skeleton-sweep 1.5s linear infinite;
    }

    @keyframes skeleton-sweep {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }

    .pane.is-loading .pane-skeleton {
      display: block;
    }

    .reveal-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .score-pill {
      font-size: 0.75rem;
      padding: 2px 8px;
      border-radius: 4px;
      background: var(--bg-secondary);
    }

    @media (max-width: 640px) {
      .pane-handle-grip {
        width: 28px;
        height: 56px;
      }

      .challenge-title {
        display: none;
      }

      .vote-actions {
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .vote-btn {
        padding: 6px 12px;
        font-size: 0.8rem;
      }

      .reveal-grid {
        grid-template-columns: 1fr;
      }

      .vote-footer {
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .round-pill {
        font-size: 0.72rem;
        padding: 3px 10px;
      }
    }

    @media (max-width: 767px) {
      .pane-handle {
        display: none;
      }

      .panes-grid {
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        touch-action: auto;
      }

      .pane {
        position: relative;
        inset: unset;
        flex: 1;
        min-height: 0;
        overflow: hidden;
      }

      .pane-left {
        clip-path: none;
        z-index: 0;
      }

      .pane[data-mobile-hidden="true"] {
        display: none;
      }

      .mobile-tabs {
        display: flex;
        flex-shrink: 0;
        border-bottom: 1px solid var(--line);
        background: var(--bg-secondary);
      }

      .mobile-tab {
        flex: 1;
        padding: 8px 0;
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        color: var(--fg-dim);
        font-size: 0.8rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        letter-spacing: 0.06em;
        transition: color 0.15s, border-color 0.15s;
      }

      .mobile-tab.active {
        color: var(--fg);
        border-bottom-color: var(--fg);
      }

      .vote-header {
        flex-wrap: wrap;
        height: auto;
        padding: 6px 0.75rem;
        gap: 4px;
      }

      .vote-header-center {
        width: 100%;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 6px;
      }

      .vote-footer {
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        justify-content: center;
      }

      .vote-footer > .nav-btn:first-child,
      .vote-footer > .nav-btn:last-child {
        flex: 0 0 auto;
      }

      .vote-actions {
        order: -1;
        width: 100%;
        justify-content: center;
      }

      .pane-right .pane-code {
        padding-left: 1rem;
      }
    }

    .mobile-tabs {
      display: none;
    }
  </style>

  <div id="vote-app">
    <div
      style="display: flex; align-items: center; justify-content: center; flex: 1; color: var(--fg-dim); font-size: 0.9rem;"
    >
      Loading challenges...
    </div>
  </div>
</Layout>

<script>
  import { codeToHtml } from "https://esm.sh/shiki@1.24.0";

  type RoundMeta = {
    slug: string;
    name: string;
    description: string | null;
    status: string;
    position: number;
  };

  type Challenge = {
    id: string;
    title: string;
    expectedFeature: string;
    prompt: string;
  };

  type Judgement = {
    challengeId: string;
    left: {
      primitive: string;
      constraints: number;
      idiomatic: number;
      visual: number;
      reasoning: string;
    };
    right: {
      primitive: string;
      constraints: number;
      idiomatic: number;
      visual: number;
      reasoning: string;
    };
    winner: "left" | "right" | "tie";
    verdict: string;
  };

  type VariantSide = { left: string; right: string };
  type UserVote = { challengeId: string; choice: string };
  type AppData = {
    round: RoundMeta;
    rounds: RoundMeta[];
    challenges: Challenge[];
    judgements: Judgement[];
    variantSides: Record<string, VariantSide>;
    userVotes: UserVote[];
    htmlMap: Record<string, Record<string, string>>;
    progressByRound: Record<string, number>;
  };

  let data: AppData | null = null;
  let currentIndex = 0;
  let currentRoundSlug = new URLSearchParams(window.location.search).get("round") ?? "";
  let showLeftCode: Record<string, boolean> = {};
  let showRightCode: Record<string, boolean> = {};
  let showReveal: Record<string, boolean> = {};
  let showPrompt = false;
  let showShortcuts = false;
  let userVotes: Record<string, string> = {};
  let freshlyVoted: Record<string, boolean> = {};
  let splitPct = 50;
  let mobileSide: "left" | "right" = "left";
  const MOBILE_BP = 768;
  const isMobile = () => window.innerWidth < MOBILE_BP;
  let _lastMobile = false;
  const highlightCache: Record<string, string> = {};

  async function highlight(src: string): Promise<string> {
    if (highlightCache[src]) return highlightCache[src];
    try {
      const result = await codeToHtml(src, {
        lang: "html",
        themes: { light: "github-light", dark: "github-dark" },
        defaultColor: false,
      });
      highlightCache[src] = result;
      return result;
    } catch (e) {
      console.error("shiki highlight failed", e);
      const escaped = src
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
      return `<pre><code>${escaped}</code></pre>`;
    }
  }

  function showErrorToast(retrying: boolean, onRetry?: () => void) {
    const existing = document.getElementById("error-toast");
    if (existing) existing.remove();
    const el = document.createElement("div");
    el.id = "error-toast";
    el.className = "error-toast";
    if (retrying) {
      el.innerHTML = `<span class="error-toast-spinner"></span><span>Couldn't load data. Retrying…</span>`;
    } else {
      const span = document.createElement("span");
      span.textContent = "Couldn't load data. ";
      const btn = document.createElement("button");
      btn.className = "error-toast-retry-btn";
      btn.textContent = "Retry";
      btn.addEventListener("click", () => {
        el.remove();
        if (onRetry) onRetry();
      });
      el.appendChild(span);
      el.appendChild(btn);
    }
    document.body.appendChild(el);
  }

  async function loadWithRetry(url: string, attempts = 3): Promise<Response> {
    for (let i = 0; i < attempts; i++) {
      try {
        const res = await fetch(url);
        if (res.ok) {
          document.getElementById("error-toast")?.remove();
          return res;
        }
        throw new Error(`HTTP ${res.status}`);
      } catch (err) {
        if (i < attempts - 1) {
          showErrorToast(true);
          await new Promise((r) => setTimeout(r, 1000 * Math.pow(2, i)));
        } else {
          showErrorToast(false, () => loadWithRetry(url, attempts).then(() => loadData(currentRoundSlug || undefined)));
          throw err;
        }
      }
    }
    throw new Error("unreachable");
  }

  async function loadData(roundSlug?: string) {
    const qs = roundSlug ? `?round=${roundSlug}` : "";
    const res = await loadWithRetry(`/api/data${qs}`);
    data = (await res.json()) as AppData;
    userVotes = {};
    for (const v of data.userVotes) {
      userVotes[v.challengeId] = v.choice;
    }
    currentRoundSlug = data.round.slug;
    render();
  }

  async function switchRound(slug: string) {
    currentIndex = 0;
    showLeftCode = {};
    showRightCode = {};
    showReveal = {};
    freshlyVoted = {};
    const url = new URL(window.location.href);
    url.searchParams.set("round", slug);
    window.history.pushState({}, "", url.toString());
    await loadData(slug);
  }

  function showToast(message: string) {
    const existing = document.getElementById("vote-toast");
    if (existing) existing.remove();
    const el = document.createElement("div");
    el.id = "vote-toast";
    el.className = "vote-toast";
    el.textContent = message;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 2300);
  }

  async function submitVote(challengeId: string, choice: string) {
    const res = await fetch("/api/vote", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ challengeId, choice }),
    });
    if (res.ok) {
      const wasNew = !userVotes[challengeId];
      userVotes[challengeId] = choice;
      if (wasNew) {
        freshlyVoted[challengeId] = true;
        showReveal[challengeId] = true;
        if (data?.progressByRound) {
          data.progressByRound[currentRoundSlug] =
            (data.progressByRound[currentRoundSlug] ?? 0) + 1;
        }
        showToast(`✓ Vote recorded · ${choice.toUpperCase()}`);
      }
      render();
    }
  }

  function getHtml(challengeId: string, side: "left" | "right"): string {
    if (!data) return "";
    const variantKey = data.variantSides[challengeId]?.[side];
    if (!variantKey) return "";
    return data.htmlMap[challengeId]?.[variantKey] ?? "";
  }

  function getJudgement(challengeId: string): Judgement | undefined {
    return data?.judgements.find((j) => j.challengeId === challengeId);
  }

  function variantLabel(challengeId: string, side: "left" | "right"): string {
    if (!data) return "";
    const key = data.variantSides[challengeId]?.[side];
    return key === "A-with-mcp" ? "css-bash" : "vanilla";
  }

  function variantBadge(challengeId: string, side: "left" | "right"): string {
    if (!data) return "";
    const key = data.variantSides[challengeId]?.[side];
    return key === "A-with-mcp" ? "A" : "B";
  }

  function variantColor(challengeId: string, side: "left" | "right"): string {
    if (!data) return "";
    const key = data.variantSides[challengeId]?.[side];
    return key === "A-with-mcp" ? "#f59e0b" : "#0ea5e9";
  }

  function agreementBadge(
    judgement: Judgement,
    userChoice: string,
  ): "agree" | "partial" | "disagree" {
    const judgeWon = judgement.winner;
    if (judgeWon === "tie" && userChoice === "tie") return "agree";
    if (judgeWon === userChoice) return "agree";
    if (judgeWon === "tie" || userChoice === "tie") return "partial";
    return "disagree";
  }

  const iconCode2 = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="12" y1="2" x2="12" y2="22" stroke-width="1.5" stroke-dasharray="2 2"/></svg>`;
  const iconEye = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`;
  const iconLeft = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>`;
  const iconRight = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>`;
  const iconEqual = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="9" x2="19" y2="9"/><line x1="5" y1="15" x2="19" y2="15"/></svg>`;
  const iconCheck = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
  const iconX = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>`;
  const iconInfo = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;

  async function render() {
    if (!data) return;
    const app = document.getElementById("vote-app");
    if (!app) return;

    const challenge = data.challenges[currentIndex];
    const voted = userVotes[challenge.id];
    const judg = getJudgement(challenge.id);
    const reveal = showReveal[challenge.id];
    const leftCodeOn = showLeftCode[challenge.id] ?? false;
    const rightCodeOn = showRightCode[challenge.id] ?? false;
    const leftHtml = getHtml(challenge.id, "left");
    const rightHtml = getHtml(challenge.id, "right");

    const badge = voted && judg ? agreementBadge(judg, voted) : null;
    const badgeColor =
      badge === "agree" ? "#22c55e" : badge === "partial" ? "#eab308" : "#ef4444";
    const badgeIcon = badge === "agree" ? iconCheck : iconX;
    const badgeLabel =
      badge === "agree"
        ? "Agree with judge"
        : badge === "partial"
          ? "Partial match"
          : "Disagree";

    const leftHighlighted = leftCodeOn ? await highlight(leftHtml) : "";
    const rightHighlighted = rightCodeOn ? await highlight(rightHtml) : "";

    const roundPills = data.rounds
      .map((r) => {
        const progress = data!.progressByRound?.[r.slug] ?? 0;
        const isComplete = progress >= 10;
        const isActive = r.slug === currentRoundSlug;
        const classes = [
          "round-pill",
          isActive ? "active" : "",
          isComplete ? "complete" : "",
        ]
          .filter(Boolean)
          .join(" ");
        const check = isComplete
          ? `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`
          : "";
        const counter =
          progress > 0
            ? `<span class="progress-count">${isComplete ? "10/10" : `${progress}/10`}</span>`
            : "";
        return `<button class="${classes}" data-round="${r.slug}">${check}<span>${r.name}</span>${counter}</button>`;
      })
      .join("");

    const revealPanel =
      reveal && judg
        ? `<button id="reveal-back-fab" class="reveal-back-fab" type="button" title="Back to compare view" aria-label="Back to compare view">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          back to compare
        </button>
        <div class="reveal-panel">
        <div class="reveal-inner">
          <div class="reveal-header">
            <h3 style="margin: 0; font-size: 1rem; font-weight: 700;">Judge verdict</h3>
            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
              <span style="font-size: 0.8rem; color: var(--fg-dim); display: inline-flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <span style="display: inline-flex; align-items: center; gap: 6px;">
                  LEFT
                  <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: ${variantColor(challenge.id, "left")}20; color: ${variantColor(challenge.id, "left")}; border: 1px solid ${variantColor(challenge.id, "left")}40; font-weight: 600; font-size: 0.7rem;">
                    <span style="font-weight: 800;">${variantBadge(challenge.id, "left")}</span>
                    ${variantLabel(challenge.id, "left")}
                  </span>
                </span>
                <span style="display: inline-flex; align-items: center; gap: 6px;">
                  RIGHT
                  <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: ${variantColor(challenge.id, "right")}20; color: ${variantColor(challenge.id, "right")}; border: 1px solid ${variantColor(challenge.id, "right")}40; font-weight: 600; font-size: 0.7rem;">
                    <span style="font-weight: 800;">${variantBadge(challenge.id, "right")}</span>
                    ${variantLabel(challenge.id, "right")}
                  </span>
                </span>
              </span>
              <span style="font-size: 0.75rem; padding: 3px 10px; border-radius: 999px; background: ${judg.winner === "tie" ? "#eab30820" : "#a855f720"}; color: ${judg.winner === "tie" ? "#eab308" : "#a855f7"}; border: 1px solid ${judg.winner === "tie" ? "#eab30840" : "#a855f740"};">
                ${judg.winner === "tie" ? "Tie" : judg.winner === "left" ? "LEFT wins" : "RIGHT wins"}
              </span>
            </div>
          </div>
          <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; padding: 0.5rem 0.75rem; border: 1px dashed var(--line); border-radius: 8px; background: var(--bg-secondary); font-size: 0.7rem; color: var(--fg-dim);">
            <span style="display: inline-flex; align-items: center; gap: 6px;">
              <span style="width: 12px; height: 12px; border-radius: 3px; border: 2px solid #10b981; background: #10b98115;"></span>
              your vote
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px;">
              <span style="width: 12px; height: 12px; border-radius: 3px; border: 2px solid #a855f7; background: #a855f715;"></span>
              judge pick
            </span>
            <span style="display: inline-flex; align-items: center; gap: 6px;">
              <span style="width: 12px; height: 12px; border-radius: 3px; background: linear-gradient(var(--bg-secondary), var(--bg-secondary)) padding-box, linear-gradient(135deg, #10b981, #a855f7) border-box; border: 2px solid transparent;"></span>
              both agreed
            </span>
          </div>
          <div class="reveal-grid">
            ${(["left", "right"] as const)
              .map((side) => {
                const s = judg[side];
                const isUserVote = voted === side;
                const isJudgePick = judg.winner === side;
                let cardStyle = "padding: 1rem; border: 1px solid var(--line); border-radius: 8px; background: var(--bg);";
                let badge = "";
                if (isUserVote && isJudgePick) {
                  cardStyle = `padding: 1rem; border-radius: 8px; background: linear-gradient(var(--bg), var(--bg)) padding-box, linear-gradient(135deg, #10b981, #a855f7) border-box; border: 2px solid transparent;`;
                  badge = `<span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: linear-gradient(135deg, #10b98120, #a855f720); color: #a855f7; border: 1px solid transparent; background-clip: padding-box; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">your vote · judge pick</span>`;
                } else if (isUserVote) {
                  cardStyle = "padding: 1rem; border: 2px solid #10b981; border-radius: 8px; background: #10b98108;";
                  badge = `<span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: #10b98120; color: #10b981; border: 1px solid #10b98140; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">your vote</span>`;
                } else if (isJudgePick) {
                  cardStyle = "padding: 1rem; border: 2px solid #a855f7; border-radius: 8px; background: #a855f708;";
                  badge = `<span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: #a855f720; color: #a855f7; border: 1px solid #a855f740; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">judge pick</span>`;
                }
                return `
              <div style="${cardStyle}">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px; flex-wrap: wrap;">
                  <span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-dim);">${side.toUpperCase()}</span>
                  <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: ${variantColor(challenge.id, side)}20; color: ${variantColor(challenge.id, side)}; border: 1px solid ${variantColor(challenge.id, side)}40; font-size: 0.7rem; font-weight: 600;">
                    <span style="font-weight: 800;">${variantBadge(challenge.id, side)}</span>
                    ${variantLabel(challenge.id, side)}
                  </span>
                  ${badge}
                </div>
                <div style="display: flex; gap: 0.5rem; margin-bottom: 8px; flex-wrap: wrap;">
                  <span class="score-pill">constraints: ${s.constraints}/3</span>
                  <span class="score-pill">idiomatic: ${s.idiomatic}/5</span>
                  <span class="score-pill">visual: ${s.visual}/5</span>
                  <span class="score-pill">primitive: ${s.primitive}</span>
                </div>
                <p style="margin: 0; font-size: 0.8rem; color: var(--fg-dim); line-height: 1.5;">${s.reasoning}</p>
              </div>`;
              })
              .join("")}
          </div>
          <div style="padding: 1rem; border: 1px solid var(--line); border-radius: 8px; background: var(--bg);">
            <div style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-dim); margin-bottom: 6px;">Verdict</div>
            <p style="margin: 0; font-size: 0.875rem; color: var(--fg); line-height: 1.6;">${judg.verdict}</p>
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); flex-wrap: wrap;">
            <button id="reveal-btn-prev" class="nav-btn" ${currentIndex === 0 ? "disabled" : ""}>${iconLeft} back</button>
            <button id="reveal-btn-close" class="nav-btn">back to compare</button>
            <button id="reveal-btn-next" class="nav-btn">
              ${currentIndex < data.challenges.length - 1 ? `next ${iconRight}` : `results ${iconRight}`}
            </button>
          </div>
        </div>
      </div>`
        : "";

    app.innerHTML = `
      <div class="vote-header">
        <a href="/" style="font-weight: 700; font-size: 0.9rem; color: var(--fg); text-decoration: none; flex-shrink: 0;">css<span style="color: #f59e0b;">-bash</span></a>
        <div class="vote-header-center">
          <span style="font-size: 0.8rem; color: var(--fg-dim);">${currentIndex + 1} / ${data.challenges.length}</span>
          <span class="challenge-title">${challenge.title}</span>
          <button id="btn-prompt" class="prompt-trigger${showPrompt ? " active" : ""}" type="button" title="View challenge prompt">
            ${iconInfo}
            <span>prompt</span>
          </button>
          <a href="/results?round=${currentRoundSlug}" style="font-size: 0.8rem; color: var(--fg-dim); text-decoration: none; padding: 4px 10px; border: 1px solid var(--line); border-radius: 6px; flex-shrink: 0;">Results</a>
        </div>
      </div>

      ${
        showPrompt
          ? `<div class="prompt-overlay" id="prompt-overlay">
        <div class="prompt-modal-wrapper">
          <div class="prompt-modal">
            <h3>${challenge.title}</h3>
            <div class="prompt-modal-meta">
              <span style="padding: 2px 8px; background: var(--bg-secondary); border-radius: 4px;">${currentIndex + 1} / ${data.challenges.length}</span>
              <span>Expected: <strong style="color: var(--fg);">${challenge.expectedFeature}</strong></span>
            </div>
            <pre>${challenge.prompt.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</pre>
            <button id="btn-prompt-close" class="prompt-modal-close" type="button" title="Close" aria-label="Close prompt">${iconX}</button>
          </div>
        </div>
      </div>`
          : ""
      }

      ${
        showShortcuts
          ? `<div class="prompt-overlay" id="shortcuts-overlay">
        <div class="prompt-modal-wrapper">
          <div class="prompt-modal">
            <h3>Keyboard shortcuts</h3>
            <table class="shortcuts-table">
              <tbody>
                <tr><td><span class="shortcut-key">←</span> <span class="shortcut-key">→</span></td><td>Previous / next challenge</td></tr>
                <tr><td><span class="shortcut-key">1</span></td><td>Vote LEFT wins</td></tr>
                <tr><td><span class="shortcut-key">2</span></td><td>Vote tie</td></tr>
                <tr><td><span class="shortcut-key">3</span></td><td>Vote RIGHT wins</td></tr>
                <tr><td><span class="shortcut-key">j</span></td><td>Toggle judge reveal (after voting)</td></tr>
                <tr><td><span class="shortcut-key">c</span></td><td>Toggle code on left pane</td></tr>
                <tr><td><span class="shortcut-key">v</span></td><td>Toggle code on right pane</td></tr>
                <tr><td><span class="shortcut-key">?</span></td><td>Toggle this shortcuts modal</td></tr>
                <tr><td><span class="shortcut-key">Esc</span></td><td>Close modal / close reveal panel</td></tr>
              </tbody>
            </table>
            <button id="btn-shortcuts-close" class="prompt-modal-close" type="button" title="Close" aria-label="Close shortcuts">${iconX}</button>
          </div>
        </div>
      </div>`
          : ""
      }

      <div class="round-selector" id="round-selector">
        ${roundPills}
      </div>

      <div class="mobile-tabs" id="mobile-tabs">
        <button class="mobile-tab${mobileSide === "left" ? " active" : ""}" id="mobile-tab-left" type="button">LEFT</button>
        <button class="mobile-tab${mobileSide === "right" ? " active" : ""}" id="mobile-tab-right" type="button">RIGHT</button>
      </div>

      <div class="panes-grid" id="panes-grid" style="flex: 1; min-height: 0;">
        <div class="pane pane-right is-loading" id="pane-right-el" data-mobile-hidden="${mobileSide === "left" ? "true" : "false"}">
          ${
            rightCodeOn
              ? `<div class="pane-code">${rightHighlighted || `<pre><code>${rightHtml.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</code></pre>`}</div>`
              : `<iframe id="right-iframe" class="pane-iframe" srcdoc="" sandbox="allow-scripts allow-same-origin"></iframe>`
          }
          <div class="pane-skeleton"></div>
        </div>

        <div class="pane pane-left is-loading" id="pane-left-el" data-mobile-hidden="${mobileSide === "right" ? "true" : "false"}">
          ${
            leftCodeOn
              ? `<div class="pane-code">${leftHighlighted || `<pre><code>${leftHtml.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</code></pre>`}</div>`
              : `<iframe id="left-iframe" class="pane-iframe" srcdoc="" sandbox="allow-scripts allow-same-origin"></iframe>`
          }
          <div class="pane-skeleton"></div>
        </div>

        <div class="pane-controls left">
          <span class="label">LEFT</span>
          <button id="left-toggle" class="toggle${leftCodeOn ? " active" : ""}" title="${leftCodeOn ? "View preview" : "View code"}" aria-label="${leftCodeOn ? "View left pane preview" : "View left pane code"}" aria-pressed="${leftCodeOn}">
            ${leftCodeOn ? iconEye : iconCode2}
          </button>
        </div>

        <div class="pane-controls right">
          <span class="label">RIGHT</span>
          <button id="right-toggle" class="toggle${rightCodeOn ? " active" : ""}" title="${rightCodeOn ? "View preview" : "View code"}" aria-label="${rightCodeOn ? "View right pane preview" : "View right pane code"}" aria-pressed="${rightCodeOn}">
            ${rightCodeOn ? iconEye : iconCode2}
          </button>
        </div>

        <div class="pane-handle" id="pane-handle" role="separator" aria-label="Drag to resize panes" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
          <div class="pane-handle-grip">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/><polyline points="9 6 9 6"/></svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: -6px;" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        </div>

        <div class="shortcuts-hint" id="shortcuts-hint">Press ? for shortcuts</div>
      </div>

      <div class="vote-footer">
        <button id="btn-prev" class="nav-btn" ${currentIndex === 0 ? "disabled" : ""}>${iconLeft} back</button>

        <div class="vote-actions">
          ${
            !voted
              ? `<button id="btn-left" class="vote-btn" style="border: 2px solid #f59e0b; color: #f59e0b;">${iconLeft} LEFT wins</button>
                 <button id="btn-tie" class="vote-btn" style="border: 2px solid var(--fg-dim); color: var(--fg-dim);">${iconEqual} tie</button>
                 <button id="btn-right" class="vote-btn" style="border: 2px solid #0ea5e9; color: #0ea5e9;">RIGHT wins ${iconRight}</button>`
              : `<span style="font-size: 0.85rem; color: var(--fg-dim);">voted: <strong style="color: var(--fg);">${voted.toUpperCase()}</strong></span>
                 ${badge ? `<span style="font-size: 0.75rem; padding: 3px 10px; border-radius: 999px; border: 1px solid ${badgeColor}; color: ${badgeColor}; display: inline-flex; align-items: center; gap: 4px;">${badgeIcon} ${badgeLabel}</span>` : ""}
                 <button id="btn-reveal" class="nav-btn">${reveal ? "back to compare" : "see judge"}</button>`
          }
        </div>

        <button id="btn-next" class="nav-btn" style="${currentIndex < data.challenges.length - 1 ? "background: var(--fg); color: var(--bg); border-color: var(--fg);" : ""}" ${currentIndex >= data.challenges.length - 1 && !voted ? "disabled" : ""}>
          ${currentIndex < data.challenges.length - 1 ? `next ${iconRight}` : `results ${iconRight}`}
        </button>
      </div>

      ${revealPanel}
    `;

    const leftIframe = document.getElementById(
      "left-iframe",
    ) as HTMLIFrameElement | null;
    const rightIframe = document.getElementById(
      "right-iframe",
    ) as HTMLIFrameElement | null;

    const leftPaneEl = document.getElementById("pane-left-el");
    const rightPaneEl = document.getElementById("pane-right-el");

    if (leftIframe) {
      leftIframe.onload = () => {
        leftPaneEl?.classList.remove("is-loading");
      };
      leftIframe.srcdoc = leftHtml;
    } else {
      leftPaneEl?.classList.remove("is-loading");
    }

    if (rightIframe) {
      rightIframe.onload = () => {
        rightPaneEl?.classList.remove("is-loading");
      };
      rightIframe.srcdoc = rightHtml;
    } else {
      rightPaneEl?.classList.remove("is-loading");
    }

    document.getElementById("btn-prev")?.addEventListener("click", () => {
      if (currentIndex > 0) {
        currentIndex--;
        showPrompt = false;
        render();
      }
    });

    document.getElementById("btn-next")?.addEventListener("click", () => {
      if (currentIndex < data!.challenges.length - 1) {
        currentIndex++;
        showPrompt = false;
        render();
      } else {
        window.location.href = `/results?round=${currentRoundSlug}`;
      }
    });

    document.getElementById("btn-left")?.addEventListener("click", () => {
      submitVote(challenge.id, "left");
    });
    document.getElementById("btn-tie")?.addEventListener("click", () => {
      submitVote(challenge.id, "tie");
    });
    document.getElementById("btn-right")?.addEventListener("click", () => {
      submitVote(challenge.id, "right");
    });

    document.getElementById("btn-reveal")?.addEventListener("click", () => {
      showReveal[challenge.id] = !showReveal[challenge.id];
      render();
    });

    document.getElementById("btn-prompt")?.addEventListener("click", () => {
      showPrompt = !showPrompt;
      render();
    });
    document.getElementById("btn-prompt-close")?.addEventListener("click", () => {
      showPrompt = false;
      render();
    });
    // Click outside the modal closes it
    document.getElementById("prompt-overlay")?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).id === "prompt-overlay") {
        showPrompt = false;
        render();
      }
    });

    document.getElementById("btn-shortcuts-close")?.addEventListener("click", () => {
      showShortcuts = false;
      render();
    });
    document.getElementById("shortcuts-overlay")?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).id === "shortcuts-overlay") {
        showShortcuts = false;
        render();
      }
    });

    // Reveal-panel nav (mirror of footer nav so user is never stuck)
    document.getElementById("reveal-btn-prev")?.addEventListener("click", () => {
      if (currentIndex > 0) {
        const prevChallenge = data!.challenges[currentIndex - 1];
        if (userVotes[prevChallenge.id] && getJudgement(prevChallenge.id)) {
          showReveal[prevChallenge.id] = true;
        }
        currentIndex--;
        showPrompt = false;
        render();
      }
    });
    document.getElementById("reveal-back-fab")?.addEventListener("click", () => {
      showReveal[challenge.id] = false;
      render();
    });
    document.getElementById("reveal-btn-close")?.addEventListener("click", () => {
      showReveal[challenge.id] = false;
      render();
    });
    document.getElementById("reveal-btn-next")?.addEventListener("click", () => {
      if (currentIndex < data!.challenges.length - 1) {
        const nextChallenge = data!.challenges[currentIndex + 1];
        if (userVotes[nextChallenge.id] && getJudgement(nextChallenge.id)) {
          showReveal[nextChallenge.id] = true;
        }
        currentIndex++;
        showPrompt = false;
        render();
      } else {
        window.location.href = `/results?round=${currentRoundSlug}`;
      }
    });

    document.getElementById("left-toggle")?.addEventListener("click", () => {
      showLeftCode[challenge.id] = !showLeftCode[challenge.id];
      render();
    });
    document.getElementById("right-toggle")?.addEventListener("click", () => {
      showRightCode[challenge.id] = !showRightCode[challenge.id];
      render();
    });

    for (const btn of document.querySelectorAll<HTMLButtonElement>(".round-pill")) {
      btn.addEventListener("click", () => {
        const slug = btn.dataset.round;
        if (slug && slug !== currentRoundSlug) {
          switchRound(slug);
        }
      });
    }

    attachDragHandle();
    attachMobileTabs();
  }

  function attachDragHandle() {
    const grid = document.getElementById("panes-grid");
    const handle = document.getElementById("pane-handle");
    if (!grid || !handle) return;

    // Restore split from module-level state so it survives re-renders
    grid.style.setProperty("--split", `${splitPct}%`);
    handle.setAttribute("aria-valuenow", String(Math.round(splitPct)));

    const setSplit = (pct: number) => {
      const clamped = Math.max(0, Math.min(100, pct));
      splitPct = clamped;
      grid.style.setProperty("--split", `${clamped}%`);
      handle.setAttribute("aria-valuenow", String(Math.round(clamped)));
    };

    let dragging = false;

    const onPointerDown = (e: PointerEvent) => {
      dragging = true;
      handle.classList.add("dragging");
      handle.setPointerCapture(e.pointerId);
      e.preventDefault();
    };

    const onPointerMove = (e: PointerEvent) => {
      if (!dragging) return;
      const rect = grid.getBoundingClientRect();
      const pct = ((e.clientX - rect.left) / rect.width) * 100;
      setSplit(pct);
    };

    const onPointerUp = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      handle.classList.remove("dragging");
      handle.releasePointerCapture(e.pointerId);

      // Soft snap to 0/50/100 if released within 6% of those anchors
      const anchors = [0, 50, 100];
      const snap = anchors.find((a) => Math.abs(splitPct - a) < 6);
      if (snap !== undefined) setSplit(snap);
    };

    handle.addEventListener("pointerdown", onPointerDown);
    handle.addEventListener("pointermove", onPointerMove);
    handle.addEventListener("pointerup", onPointerUp);
    handle.addEventListener("pointercancel", onPointerUp);

    // Keyboard support
    handle.addEventListener("keydown", (e) => {
      const step = e.shiftKey ? 10 : 2;
      if (e.key === "ArrowLeft") {
        setSplit(splitPct - step);
        e.preventDefault();
      } else if (e.key === "ArrowRight") {
        setSplit(splitPct + step);
        e.preventDefault();
      } else if (e.key === "Home") {
        setSplit(0);
      } else if (e.key === "End") {
        setSplit(100);
      } else if (e.key === " ") {
        setSplit(50);
        e.preventDefault();
      }
    });

    // Double-click resets to 50%
    handle.addEventListener("dblclick", () => setSplit(50));
  }

  function attachMobileTabs() {
    document.getElementById("mobile-tab-left")?.addEventListener("click", () => {
      if (mobileSide !== "left") {
        mobileSide = "left";
        render();
      }
    });
    document.getElementById("mobile-tab-right")?.addEventListener("click", () => {
      if (mobileSide !== "right") {
        mobileSide = "right";
        render();
      }
    });
  }

  function handleKey(e: KeyboardEvent) {
    if (!data) return;
    const tag = (e.target as HTMLElement).tagName;
    if (tag === "INPUT" || tag === "TEXTAREA") return;
    if (showPrompt || showShortcuts) {
      if (e.key === "Escape") {
        showPrompt = false;
        showShortcuts = false;
        render();
      }
      return;
    }

    const challenge = data.challenges[currentIndex];
    const voted = userVotes[challenge.id];
    const judg = getJudgement(challenge.id);
    const reveal = showReveal[challenge.id];

    if (e.key === "Escape") {
      if (reveal) {
        showReveal[challenge.id] = false;
        render();
      }
      return;
    }

    if (e.key === "ArrowLeft") {
      if (currentIndex > 0) {
        currentIndex--;
        showPrompt = false;
        render();
      }
    } else if (e.key === "ArrowRight") {
      if (currentIndex < data.challenges.length - 1) {
        currentIndex++;
        showPrompt = false;
        render();
      }
    } else if (e.key === "?" || (e.key === "/" && e.shiftKey)) {
      showShortcuts = !showShortcuts;
      render();
    } else if (e.key === "1") {
      if (!voted) submitVote(challenge.id, "left");
    } else if (e.key === "2") {
      if (!voted) submitVote(challenge.id, "tie");
    } else if (e.key === "3") {
      if (!voted) submitVote(challenge.id, "right");
    } else if (e.key === "j" || e.key === "J") {
      if (voted && judg) {
        showReveal[challenge.id] = !reveal;
        render();
      }
    } else if (e.key === "c" || e.key === "C") {
      showLeftCode[challenge.id] = !showLeftCode[challenge.id];
      render();
    } else if (e.key === "v" || e.key === "V") {
      showRightCode[challenge.id] = !showRightCode[challenge.id];
      render();
    } else if (e.key === "[") {
      showLeftCode[challenge.id] = !showLeftCode[challenge.id];
      render();
    } else if (e.key === "]") {
      showRightCode[challenge.id] = !showRightCode[challenge.id];
      render();
    } else if (e.key === "s") {
      window.location.href = `/results?round=${currentRoundSlug}`;
    }
  }

  function initPage() {
    currentRoundSlug = new URLSearchParams(window.location.search).get("round") ?? "";
    showLeftCode = {};
    showRightCode = {};
    showReveal = {};
    showPrompt = false;
    showShortcuts = false;
    userVotes = {};
    freshlyVoted = {};
    splitPct = 50;
    mobileSide = "left";
    data = null;
    currentIndex = 0;
    _lastMobile = isMobile();

    document.addEventListener("keydown", handleKey);

    window.addEventListener("resize", () => {
      const nowMobile = isMobile();
      if (nowMobile !== _lastMobile) {
        _lastMobile = nowMobile;
        render();
      }
    });

    loadData(currentRoundSlug || undefined);
  }

  document.addEventListener("astro:page-load", initPage);
</script>
