---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";

const { userId } = Astro.locals.auth();
const roundSlug = Astro.url.searchParams.get("round") ?? "";
---

<Layout title="Results">
  <Header isSignedIn={!!userId} />

  <style is:global>
    .view-nav {
      display: flex;
      gap: 0.375rem;
      margin-bottom: 1.75rem;
    }
    .view-nav-pill {
      padding: 5px 18px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: none;
      color: var(--fg-dim);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
    }
    .view-nav-pill:hover {
      border-color: var(--fg-dim);
      color: var(--fg);
    }
    .view-nav-pill.active {
      background: var(--fg);
      color: var(--bg);
      border-color: var(--fg);
    }

    .results-round-selector {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0 0 1rem;
      scroll-snap-type: x mandatory;
    }
    .results-round-selector::-webkit-scrollbar { display: none; }
    .results-round-pill {
      flex-shrink: 0;
      padding: 5px 16px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: none;
      color: var(--fg-dim);
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      white-space: nowrap;
      scroll-snap-align: start;
      text-decoration: none;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: inherit;
    }
    .results-round-pill:hover {
      border-color: var(--fg-dim);
      color: var(--fg);
    }
    .results-round-pill.active {
      background: var(--fg);
      color: var(--bg);
      border-color: var(--fg);
      font-weight: 700;
    }
    .results-round-pill.complete {
      border-color: #22c55e;
      color: #22c55e;
    }
    .results-round-pill.complete.active {
      background: #22c55e;
      color: #0b0d10;
      border-color: #22c55e;
    }
    .results-round-pill .progress-count {
      font-size: 0.7rem;
      opacity: 0.75;
      font-weight: 600;
    }

    .locked-cta {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 2rem 1.5rem;
      text-align: center;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.08), rgba(14, 165, 233, 0.05));
      border: 1px solid rgba(245, 158, 11, 0.25);
      border-radius: 12px;
      margin-bottom: 1.5rem;
    }
    .locked-cta-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--fg);
      margin: 0;
      letter-spacing: -0.01em;
    }
    .locked-cta-sub {
      font-size: 0.875rem;
      color: var(--fg-dim);
      max-width: 420px;
      margin: 0;
      line-height: 1.55;
    }
    .locked-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 20px;
      background: var(--fg);
      color: var(--bg);
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      text-decoration: none;
      font-family: inherit;
      margin-top: 0.5rem;
    }
    .locked-cta-btn:hover { opacity: 0.9; }
    .locked-mock {
      pointer-events: none;
      user-select: none;
      filter: blur(5px) saturate(0.5);
      opacity: 0.45;
    }

    @media (max-width: 640px) {
      .scoreboard-grid {
        grid-template-columns: repeat(2, 1fr) !important;
      }
      .challenge-row-header {
        flex-direction: column !important;
        align-items: flex-start !important;
      }
    }
  </style>

  <main style="max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem;">
    <h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.04em; margin: 0 0 0.5rem;">Community results</h1>
    <p style="color: var(--fg-dim); margin: 0 0 1.5rem; font-size: 0.95rem;">Aggregated votes from Crafter Station members. Variant A = css-bash (with MCP). Variant B = vanilla (without MCP).</p>

    <div class="view-nav">
      <span class="view-nav-pill active">Community</span>
      {userId && (
        <a id="nav-you" class="view-nav-pill" href="/results/me">You</a>
      )}
    </div>

    <div id="global-aggregate" style="margin-bottom: 2rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-secondary);">
      <div style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; color: var(--fg-dim); text-transform: uppercase; margin-bottom: 1rem;">Global preference</div>
      <div id="global-aggregate-content" style="color: var(--fg-dim); font-size: 0.9rem;">Loading...</div>
    </div>

    <div id="round-selector-container" style="margin-bottom: 2rem;">
      <div class="results-round-selector" id="round-pills">
        <span style="color: var(--fg-dim); font-size: 0.8rem;">Loading rounds...</span>
      </div>
    </div>

    <div style="margin-bottom: 0.5rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-dim);" id="round-label"></div>

    <div
      id="partial-banner"
      style="display: none; padding: 12px 16px; margin-bottom: 1rem; border-radius: 8px; border: 1px solid rgba(245, 158, 11, 0.3); background: rgba(245, 158, 11, 0.08); align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;"
    ></div>

    <div id="locked-cta" class="locked-cta" style="display: none;"></div>

    <div id="round-mini-aggregate" style="margin-bottom: 1rem; font-size: 0.85rem; color: var(--fg-dim);"></div>

    <div id="locked-wrapper">
      <div id="scoreboard" style="margin-bottom: 2.5rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-secondary);">
        <div style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; color: var(--fg-dim); text-transform: uppercase; margin-bottom: 1rem;">Community scoreboard</div>
        <div id="scoreboard-content" style="color: var(--fg-dim); font-size: 0.9rem;">Loading...</div>
      </div>

      <div id="challenges-list"></div>
    </div>

    {userId && (
      <div id="my-votes" style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line);">
        <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 1rem;">Your votes</h2>
        <div id="my-votes-content" style="color: var(--fg-dim); font-size: 0.9rem;">Loading...</div>
      </div>
    )}
  </main>
</Layout>

<script define:vars={{ userId, initialRoundSlug: roundSlug }}>
  let currentRoundSlug = initialRoundSlug;
  let appData = null;
  let statsData = null;
  let globalData = null;

  async function loadGlobal() {
    const res = await fetch("/api/data/all");
    globalData = await res.json();
    renderGlobalAggregate();
  }

  async function loadAll(slug) {
    const qs = slug ? `?round=${slug}` : "";
    const [dataRes, statsRes] = await Promise.all([
      fetch(`/api/data${qs}`),
      fetch(`/api/stats${qs}`),
    ]);
    appData = await dataRes.json();
    statsData = await statsRes.json();
    currentRoundSlug = appData.round?.slug ?? slug ?? "";
    updateNavYouLink();
    render();
  }

  function updateNavYouLink() {
    const navYou = document.getElementById("nav-you");
    if (navYou && currentRoundSlug) {
      navYou.href = `/results/me?round=${currentRoundSlug}`;
    }
  }

  function renderGlobalAggregate() {
    const el = document.getElementById("global-aggregate-content");
    if (!el || !globalData) return;

    const { allStats, allVariantSides } = globalData;
    if (!allStats || !allVariantSides) {
      el.textContent = "No data.";
      return;
    }

    let totalA = 0;
    let totalB = 0;
    let totalTie = 0;
    let aWins = 0;
    let bWins = 0;
    let globalTies = 0;

    for (const [challengeId, s] of Object.entries(allStats)) {
      const sides = allVariantSides[challengeId];
      if (!sides) continue;

      const aVotes =
        (sides.left === "A-with-mcp" ? (s.left || 0) : 0) +
        (sides.right === "A-with-mcp" ? (s.right || 0) : 0);
      const bVotes =
        (sides.left === "B-without-mcp" ? (s.left || 0) : 0) +
        (sides.right === "B-without-mcp" ? (s.right || 0) : 0);
      const tieVotes = s.tie || 0;

      totalA += aVotes;
      totalB += bVotes;
      totalTie += tieVotes;

      if (aVotes > bVotes) aWins++;
      else if (bVotes > aVotes) bWins++;
      else globalTies++;
    }

    const grandTotal = totalA + totalB + totalTie || 1;
    const aPct = Math.round((totalA / grandTotal) * 100);
    const bPct = Math.round((totalB / grandTotal) * 100);
    const tiePct = Math.round((totalTie / grandTotal) * 100);
    const totalVotesAll = totalA + totalB + totalTie;

    el.innerHTML = `
      <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.75rem;">
        <div style="display: flex; align-items: baseline; gap: 0.5rem;">
          <span style="font-size: 2rem; font-weight: 800; color: #f59e0b;">${aPct}%</span>
          <span style="font-size: 0.85rem; color: #f59e0b; font-weight: 600;">${totalA} votes</span>
          <span style="font-size: 0.8rem; color: var(--fg-dim); margin-left: 0.25rem;">css-bash</span>
        </div>
        <div style="display: flex; align-items: baseline; gap: 0.5rem; flex-direction: column; align-items: center;">
          <span style="font-size: 1rem; font-weight: 700; color: #eab308;">${tiePct}%</span>
          <span style="font-size: 0.75rem; color: var(--fg-dim);">tie · ${totalTie}</span>
        </div>
        <div style="display: flex; align-items: baseline; gap: 0.5rem; flex-direction: row-reverse;">
          <span style="font-size: 0.8rem; color: var(--fg-dim); margin-right: 0.25rem;">vanilla</span>
          <span style="font-size: 0.85rem; color: #0ea5e9; font-weight: 600;">${totalB} votes</span>
          <span style="font-size: 2rem; font-weight: 800; color: #0ea5e9;">${bPct}%</span>
        </div>
      </div>
      <div style="display: flex; gap: 4px; height: 36px; border-radius: 8px; overflow: hidden; margin-bottom: 1.25rem;">
        <div style="width: ${aPct}%; background: #f59e0b; min-width: ${totalA ? '2%' : '0'};"></div>
        <div style="width: ${tiePct}%; background: #eab308; min-width: ${totalTie ? '2%' : '0'};"></div>
        <div style="width: ${bPct}%; background: #0ea5e9; min-width: ${totalB ? '2%' : '0'};"></div>
        ${totalVotesAll === 0 ? '<div style="width: 100%; background: var(--line);"></div>' : ''}
      </div>
      <div class="scoreboard-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center;">
        <div>
          <div style="font-size: 1.75rem; font-weight: 800; color: #f59e0b;">${aWins}</div>
          <div style="font-size: 0.8rem; color: var(--fg-dim);">css-bash wins</div>
        </div>
        <div>
          <div style="font-size: 1.75rem; font-weight: 800; color: #0ea5e9;">${bWins}</div>
          <div style="font-size: 0.8rem; color: var(--fg-dim);">vanilla wins</div>
        </div>
        <div>
          <div style="font-size: 1.75rem; font-weight: 800; color: #eab308;">${globalTies}</div>
          <div style="font-size: 0.8rem; color: var(--fg-dim);">Ties</div>
        </div>
        <div>
          <div style="font-size: 1.75rem; font-weight: 800; color: var(--fg);">${totalVotesAll}</div>
          <div style="font-size: 0.8rem; color: var(--fg-dim);">Total votes</div>
        </div>
      </div>
    `;
  }

  function render() {
    if (!appData || !statsData) return;

    const { round, rounds, challenges, judgements, variantSides, userVotes: uvArr, progressByRound } = appData;
    const { stats, totalVotes } = statsData;
    const userVotesMap = Object.fromEntries((uvArr ?? []).map((v) => [v.challengeId, v.choice]));
    const myProgress = userId ? (progressByRound?.[currentRoundSlug] ?? 0) : 10;
    const isLocked = userId ? myProgress === 0 : false;
    const isPartial = userId ? myProgress > 0 && myProgress < 10 : false;

    const pillsEl = document.getElementById("round-pills");
    if (pillsEl) {
      pillsEl.innerHTML = (rounds ?? [])
        .map((r) => {
          const progress = progressByRound?.[r.slug] ?? 0;
          const isComplete = progress >= 10;
          const isActive = r.slug === currentRoundSlug;
          const cls = ['results-round-pill', isActive ? 'active' : '', isComplete ? 'complete' : ''].filter(Boolean).join(' ');
          const check = isComplete
            ? `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`
            : "";
          const counter = userId && progress > 0
            ? `<span class="progress-count">${isComplete ? "10/10" : `${progress}/10`}</span>`
            : "";
          return `<button class="${cls}" data-slug="${r.slug}">${check}<span>${r.name}</span>${counter}</button>`;
        })
        .join("");

      for (const btn of pillsEl.querySelectorAll(".results-round-pill")) {
        btn.addEventListener("click", () => {
          const slug = btn.dataset.slug;
          if (slug && slug !== currentRoundSlug) {
            const url = new URL(window.location.href);
            url.searchParams.set("round", slug);
            window.history.pushState({}, "", url.toString());
            loadAll(slug);
          }
        });
      }
    }

    const lockedWrapperEl = document.getElementById("locked-wrapper");
    const lockedCtaEl = document.getElementById("locked-cta");
    const partialBannerEl = document.getElementById("partial-banner");
    if (lockedCtaEl) {
      if (isLocked && round) {
        lockedCtaEl.style.display = "flex";
        lockedCtaEl.innerHTML = `
          <h3 class="locked-cta-title">Vote in this round to unlock results</h3>
          <p class="locked-cta-sub">Cast your 10 votes to see how the community ranks <strong style="color: var(--fg);">${round.name}</strong>.</p>
          <a href="/vote?round=${round.slug}" class="locked-cta-btn">Vote ${round.name}</a>
        `;
      } else {
        lockedCtaEl.style.display = "none";
      }
    }
    if (partialBannerEl) {
      if (isPartial && round) {
        partialBannerEl.style.display = "flex";
        partialBannerEl.innerHTML = `
          <div style="font-size: 0.875rem; color: var(--fg-dim);">
            You have <strong style="color: var(--fg);">${myProgress}/10</strong> votes in this round.
            <a href="/vote?round=${round.slug}" style="color: #f59e0b; text-decoration: none; font-weight: 600;">Continue voting →</a>
          </div>
        `;
      } else {
        partialBannerEl.style.display = "none";
      }
    }

    const roundLabelEl = document.getElementById("round-label");
    if (roundLabelEl) {
      roundLabelEl.textContent = round?.name ?? "";
    }

    if (lockedWrapperEl) {
      lockedWrapperEl.classList.toggle("locked-mock", isLocked);
    }

    if (isLocked) {
      const miniEl = document.getElementById("round-mini-aggregate");
      if (miniEl) miniEl.textContent = "";

      const sbEl = document.getElementById("scoreboard-content");
      if (sbEl) {
        sbEl.innerHTML = `
          <div class="scoreboard-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center;">
            <div><div style="font-size: 2rem; font-weight: 800; color: #f59e0b;">7</div><div style="font-size: 0.8rem; color: var(--fg-dim);">css-bash wins</div></div>
            <div><div style="font-size: 2rem; font-weight: 800; color: #0ea5e9;">2</div><div style="font-size: 0.8rem; color: var(--fg-dim);">vanilla wins</div></div>
            <div><div style="font-size: 2rem; font-weight: 800; color: #eab308;">1</div><div style="font-size: 0.8rem; color: var(--fg-dim);">Ties</div></div>
            <div><div style="font-size: 2rem; font-weight: 800; color: var(--fg);">128</div><div style="font-size: 0.8rem; color: var(--fg-dim);">Total votes</div></div>
          </div>
        `;
      }
      const listEl = document.getElementById("challenges-list");
      if (listEl) {
        const fakeRows = [
          { id: "fake-01", title: "Smooth scrolling parallax with depth layers", feat: "scroll-driven-animations", aPct: 68, bPct: 25, tPct: 7, total: 24 },
          { id: "fake-02", title: "Container query masonry gallery with adaptive gaps", feat: "container-queries", aPct: 41, bPct: 52, tPct: 7, total: 18 },
          { id: "fake-03", title: "Anchor-positioned tooltip with view-transition", feat: "anchor-positioning", aPct: 72, bPct: 22, tPct: 6, total: 31 },
        ];
        listEl.innerHTML = fakeRows
          .map(
            (r) => `
          <div style="margin-bottom: 1.5rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: 10px; background: var(--bg-secondary);">
            <div class="challenge-row-header" style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
              <div>
                <div style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; color: var(--fg-dim); text-transform: uppercase; margin-bottom: 4px;">${r.id}</div>
                <div style="font-size: 1rem; font-weight: 700; color: var(--fg);">${r.title}</div>
                <div style="font-size: 0.75rem; color: var(--fg-dim); margin-top: 4px;">Expected: <code style="font-family: monospace;">${r.feat}</code></div>
              </div>
              <span style="font-size: 0.75rem; padding: 4px 12px; border-radius: 999px; border: 1px solid #f59e0b40; color: #f59e0b; font-weight: 600;">Judge: css-bash</span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <div style="display: flex; gap: 4px; height: 24px; border-radius: 6px; overflow: hidden;">
                <div style="width: ${r.aPct}%; background: #f59e0b;"></div>
                <div style="width: ${r.tPct}%; background: #eab308;"></div>
                <div style="width: ${r.bPct}%; background: #0ea5e9;"></div>
              </div>
              <div style="display: flex; gap: 1rem; font-size: 0.75rem; color: var(--fg-dim); flex-wrap: wrap;">
                <span>css-bash: <strong style="color: #f59e0b;">${r.aPct}%</strong> (${Math.round(r.total * r.aPct / 100)})</span>
                <span>Tie: <strong style="color: #eab308;">${r.tPct}%</strong> (${Math.round(r.total * r.tPct / 100)})</span>
                <span>vanilla: <strong style="color: #0ea5e9;">${r.bPct}%</strong> (${Math.round(r.total * r.bPct / 100)})</span>
                <span style="margin-left: auto;">${r.total} votes</span>
              </div>
            </div>
          </div>`,
          )
          .join("");
      }
      return;
    }

    const scoreboardEl = document.getElementById("scoreboard-content");
    if (scoreboardEl) {
      let aWins = 0;
      let bWins = 0;
      let ties = 0;

      for (const challenge of challenges) {
        const s = stats[challenge.id];
        if (!s) continue;
        const sides = variantSides[challenge.id];
        if (!sides) continue;

        const aVotes =
          (sides.left === "A-with-mcp" ? s.left || 0 : 0) +
          (sides.right === "A-with-mcp" ? s.right || 0 : 0);
        const bVotes =
          (sides.left === "B-without-mcp" ? s.left || 0 : 0) +
          (sides.right === "B-without-mcp" ? s.right || 0 : 0);

        if (aVotes > bVotes) aWins++;
        else if (bVotes > aVotes) bWins++;
        else ties++;
      }

      scoreboardEl.innerHTML = `
        <div class="scoreboard-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center;">
          <div>
            <div style="font-size: 2rem; font-weight: 800; color: #f59e0b;">${aWins}</div>
            <div style="font-size: 0.8rem; color: var(--fg-dim);">css-bash wins</div>
          </div>
          <div>
            <div style="font-size: 2rem; font-weight: 800; color: #0ea5e9;">${bWins}</div>
            <div style="font-size: 0.8rem; color: var(--fg-dim);">vanilla wins</div>
          </div>
          <div>
            <div style="font-size: 2rem; font-weight: 800; color: #eab308;">${ties}</div>
            <div style="font-size: 0.8rem; color: var(--fg-dim);">Ties</div>
          </div>
          <div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--fg);">${totalVotes}</div>
            <div style="font-size: 0.8rem; color: var(--fg-dim);">Total votes</div>
          </div>
        </div>
      `;
    }

    const miniEl = document.getElementById("round-mini-aggregate");
    if (miniEl && round) {
      let roundA = 0;
      let roundB = 0;
      let roundTie = 0;

      for (const challenge of challenges) {
        const s = stats[challenge.id];
        if (!s) continue;
        const sides = variantSides[challenge.id];
        if (!sides) continue;

        const aVotes =
          (sides.left === "A-with-mcp" ? (s.left || 0) : 0) +
          (sides.right === "A-with-mcp" ? (s.right || 0) : 0);
        const bVotes =
          (sides.left === "B-without-mcp" ? (s.left || 0) : 0) +
          (sides.right === "B-without-mcp" ? (s.right || 0) : 0);

        roundA += aVotes;
        roundB += bVotes;
        roundTie += s.tie || 0;
      }

      const roundTotal = roundA + roundB + roundTie || 1;
      const rAPct = Math.round((roundA / roundTotal) * 100);
      const rBPct = Math.round((roundB / roundTotal) * 100);
      const rTPct = Math.round((roundTie / roundTotal) * 100);

      miniEl.innerHTML = `<span style="font-weight: 600; color: var(--fg);">${round.name}:</span> css-bash <strong style="color: #f59e0b;">${rAPct}%</strong> · vanilla <strong style="color: #0ea5e9;">${rBPct}%</strong> · ties <strong style="color: #eab308;">${rTPct}%</strong>`;
    }

    const listEl = document.getElementById("challenges-list");
    if (listEl) {
      listEl.innerHTML = challenges
        .map((challenge) => {
          const judg = (judgements ?? []).find((j) => j.challengeId === challenge.id);
          const sides = (variantSides ?? {})[challenge.id];
          const s = stats[challenge.id] || { left: 0, right: 0, tie: 0, total: 0 };

          const aVotes =
            (sides?.left === "A-with-mcp" ? (s.left || 0) : 0) +
            (sides?.right === "A-with-mcp" ? (s.right || 0) : 0);
          const bVotes =
            (sides?.left === "B-without-mcp" ? (s.left || 0) : 0) +
            (sides?.right === "B-without-mcp" ? (s.right || 0) : 0);
          const tieVotes = s.tie || 0;
          const total = aVotes + bVotes + tieVotes || 1;

          const aPct = Math.round((aVotes / total) * 100);
          const bPct = Math.round((bVotes / total) * 100);
          const tiePct = Math.round((tieVotes / total) * 100);

          const judgeBadge = judg
            ? (() => {
                const isATie = judg.winner === "tie";
                const aWon =
                  (judg.winner === "left" && sides?.left === "A-with-mcp") ||
                  (judg.winner === "right" && sides?.right === "A-with-mcp");
                const color = isATie ? "#eab308" : aWon ? "#f59e0b" : "#0ea5e9";
                const label = isATie ? "tie" : aWon ? "css-bash" : "vanilla";
                return `<span style="font-size: 0.75rem; padding: 4px 12px; border-radius: 999px; border: 1px solid ${color}40; color: ${color}; font-weight: 600; flex-shrink: 0;">Judge: ${label}</span>`;
              })()
            : "";

          const rawTotal = (s.left || 0) + (s.right || 0) + (s.tie || 0);

          return `
          <div style="margin-bottom: 1.5rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: 10px; background: var(--bg-secondary);">
            <div class="challenge-row-header" style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap;">
              <div>
                <div style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; color: var(--fg-dim); text-transform: uppercase; margin-bottom: 4px;">${challenge.id}</div>
                <div style="font-size: 1rem; font-weight: 700; color: var(--fg);">${challenge.title}</div>
                <div style="font-size: 0.75rem; color: var(--fg-dim); margin-top: 4px;">Expected: <code style="font-family: monospace;">${challenge.expectedFeature}</code></div>
              </div>
              ${judgeBadge}
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <div style="display: flex; gap: 4px; height: 24px; border-radius: 6px; overflow: hidden;">
                <div style="width: ${aPct}%; background: #f59e0b; transition: width 0.5s; min-width: ${aVotes ? "2%" : "0"};"></div>
                <div style="width: ${tiePct}%; background: #eab308; transition: width 0.5s; min-width: ${tieVotes ? "2%" : "0"};"></div>
                <div style="width: ${bPct}%; background: #0ea5e9; transition: width 0.5s; min-width: ${bVotes ? "2%" : "0"};"></div>
                ${rawTotal === 0 ? '<div style="width: 100%; background: var(--line);"></div>' : ""}
              </div>
              <div style="display: flex; gap: 1rem; font-size: 0.75rem; color: var(--fg-dim); flex-wrap: wrap;">
                <span>css-bash: <strong style="color: #f59e0b;">${aPct}%</strong> (${aVotes})</span>
                <span>Tie: <strong style="color: #eab308;">${tiePct}%</strong> (${tieVotes})</span>
                <span>vanilla: <strong style="color: #0ea5e9;">${bPct}%</strong> (${bVotes})</span>
                <span style="margin-left: auto;">${rawTotal} votes</span>
              </div>
            </div>
          </div>`;
        })
        .join("");
    }

    if (userId) {
      const myVotesEl = document.getElementById("my-votes-content");
      if (myVotesEl) {
        if (Object.keys(userVotesMap).length === 0) {
          myVotesEl.innerHTML = `<p>You haven't voted on this round yet. <a href="/vote?round=${currentRoundSlug}" style="color: var(--fg);">Start voting →</a></p>`;
        } else {
          const rows = challenges
            .map((c) => {
              const v = userVotesMap[c.id];
              const sides = (variantSides ?? {})[c.id];
              if (!v)
                return `<tr><td style="padding: 8px 0; color: var(--fg-dim);">${c.title}</td><td style="padding: 8px; color: var(--fg-dim);">-</td></tr>`;
              const choiceLabel =
                v === "tie"
                  ? "Tie"
                  : v === "left"
                    ? sides?.left === "A-with-mcp" ? "css-bash" : "vanilla"
                    : sides?.right === "A-with-mcp" ? "css-bash" : "vanilla";
              return `<tr><td style="padding: 8px 0; color: var(--fg);">${c.title}</td><td style="padding: 8px; color: var(--fg); font-weight: 600;">${choiceLabel}</td></tr>`;
            })
            .join("");
          myVotesEl.innerHTML = `<table style="width: 100%; border-collapse: collapse;">${rows}</table>`;
        }
      }
    }
  }

  window.addEventListener("popstate", () => {
    const slug = new URLSearchParams(window.location.search).get("round") ?? "";
    loadAll(slug);
  });

  loadGlobal();
  loadAll(currentRoundSlug);
</script>
